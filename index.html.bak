            render: () => `
              <div style="width:100%; font-size:0.72rem;">
                <div style="display:flex; justify-content:space-between; color:var(--text-dim); border-bottom:1px solid rgba(255,255,255,0.08); padding-bottom:0.3rem;">
                  <span>Node</span> <span>Bandwidth</span> <span>Status</span>
                </div>
                <div style="display:flex; justify-content:space-between; padding:0.4rem 0; color:#ffffff;">
                  <span>0xN1</span> <span>1.4 TB/s</span> <span style="color:var(--cyan-electric);">Engaged</span>
                </div>
                <div style="display:flex; justify-content:space-between; padding:0.4rem 0; color:#ffffff;">
                  <span>0xN2</span> <span>8.9 TB/s</span> <span style="color:var(--pink-accent);">Supercharged</span>
                </div>
              </div>`
          },
          {
            id: 'charts',
            name: 'Volumetric Bio-Chart',
            rule: 'Use to reveal temporal patterns, deviations, and trends across timeline axes.',
            code: `<div class="bio-chart-bar-wrap">\n  <div class="bar" style="height: 60%;"></div>\n  <div class="bar highlight" style="height: 90%;"></div>\n</div>`,
            render: () => `
              <div style="width:100%; display:flex; align-items:flex-end; gap:8px; height:48px;">
                <div style="flex:1; height:35%; background:var(--cyan-electric); border-radius:3px 3px 0 0;"></div>
                <div style="flex:1; height:60%; background:var(--cyan-electric); border-radius:3px 3px 0 0;"></div>
                <div style="flex:1; height:90%; background:linear-gradient(to top, var(--cyan-electric), var(--pink-accent)); border-radius:3px 3px 0 0; box-shadow:0 0 8px var(--pink-accent);"></div>
                <div style="flex:1; height:45%; background:var(--cyan-electric); border-radius:3px 3px 0 0;"></div>
                <div style="flex:1; height:75%; background:var(--cyan-electric); border-radius:3px 3px 0 0;"></div>

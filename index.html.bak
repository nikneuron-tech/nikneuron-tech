              </div>`
          },
          {
            id: 'dropdowns',
            name: 'Orbital Select Menu',
            rule: 'Use when selecting one option from a curated list of 5 or more options.',
            code: `<select class="orbital-select">\n  <option>Volumetric Spatial</option>\n  <option>Acoustic Sub-vocal</option>\n</select>`,
            render: () => `
              <select style="width:100%; background:rgba(10,20,50,0.8); border:1px solid var(--border-glass); border-radius:8px; padding:0.55rem 0.8rem; color:#ffffff; font-size:0.82rem; outline:none;" data-action="orbital-select">
                <option>Volumetric Spatial (Default)</option>
                <option>Acoustic Sub-vocal</option>
                <option>Retinal Laser Projection</option>
              </select>`
          }
        ]
      },
      {
        id: 'feedback',
        name: 'Feedback',
        index: 2,
        eyebrow: 'Face 03 // Perception',
        desc: 'Signals, vibrations, and visual affirmations verifying system state changes and computational health.',
        euler: { x: -Math.PI / 2, y: 0, z: 0 },
        components: [
          {
            id: 'toasts',
            name: 'Synaptic Signal Toast',
            rule: 'Use for transient status notices that do not require explicit human acknowledgment.',
            code: `function emitToast(message) {\n  const toast = document.createElement('div');\n  toast.className = 'synaptic-toast';\n  toast.textContent = message;\n  document.body.appendChild(toast);\n}`,
            render: () => `
              <button class="demo-btn-primary" data-action="emit-toast">
                Emit Toast Event
              </button>`
          },
          {
            id: 'alerts',
            name: 'Holographic Banner Alert',
            rule: 'Use when crucial system conditions require sustained attention before proceeding.',

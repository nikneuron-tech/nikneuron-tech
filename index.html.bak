            render: () => `
              <div style="border:1.5px solid var(--cyan-electric); width:80px; height:50px; border-radius:6px; display:flex; align-items:center; justify-content:center; box-shadow:0 0 15px rgba(79,216,255,0.3);">
                <span style="font-size:0.65rem; color:#ffffff; font-family:var(--font-display);">TARGET LOCK</span>
              </div>`
          },
          {
            id: 'adaptive-layouts',
            name: 'Cognitive Load Adapter',
            rule: 'Use to automatically simplify information density when user stress spikes.',

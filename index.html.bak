                  <span>PHASE 02 / 03</span> <span>68%</span>
                </div>
                <div style="width:100%; height:6px; background:rgba(255,255,255,0.08); border-radius:999px; overflow:hidden;">
                  <div style="width:68%; height:100%; background:linear-gradient(90deg, var(--cyan-electric), var(--pink-accent)); box-shadow:0 0 10px var(--cyan-electric);"></div>
                </div>
              </div>`
          },
          {
            id: 'empty-states',
            name: 'Zero-State Hologram',
            rule: 'Use when a query yields no entities, nudging the user with restorative options.',
            code: `<div class="zero-state">\n  <h4>No Disrupted Frequencies</h4>\n  <p>All quantum channels are clear</p>\n</div>`,
            render: () => `
              <div style="text-align:center; display:flex; flex-direction:column; align-items:center; gap:0.3rem;">
                <div style="width:14px; height:14px; border:1px dashed var(--cyan-electric); border-radius:3px;"></div>

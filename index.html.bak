          {
            id: 'dashboards',
            name: 'Adaptive Gauge Cluster',
            rule: 'Use at top-level command screens for rapid executive overview and situational awareness.',
            code: `<div class="gauge-cluster">\n  <div class="gauge-item"><small>LATENCY</small><h4>0.02ms</h4></div>\n</div>`,
            render: () => `
              <div style="display:flex; gap:1rem; width:100%; justify-content:space-around;">
                <div style="text-align:center;">
                  <span style="font-size:0.65rem; color:var(--text-dim);">LATENCY</span>
                  <div style="font-family:var(--font-display); font-size:1.1rem; color:#ffffff;">0.02ms</div>
                </div>
                <div style="text-align:center;">
                  <span style="font-size:0.65rem; color:var(--text-dim);">ATTENTION</span>

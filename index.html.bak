              </div>`
          },
          {
            id: 'gesture',
            name: 'Micro-Kinetic Spatial Mesh',
            rule: 'Use for sub-millimeter finger tracking in three-dimensional spatial volume.',
            code: `<div class="spatial-mesh-reticle">\n  <div class="finger-node"></div>\n</div>`,
            render: () => `
              <div style="position:relative; width:44px; height:44px; border:1px dashed var(--cyan-electric); border-radius:50%; display:flex; align-items:center; justify-content:center;">
                <div style="width:12px; height:12px; border-radius:50%; background:var(--pink-accent); box-shadow:0 0 10px var(--pink-accent);"></div>
              </div>`
          },
          {
            id: 'spatial-ar',
            name: 'Volumetric Reticle HUD',

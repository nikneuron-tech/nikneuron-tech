            render: () => `
              <div style="width:100%; background:rgba(255,90,165,0.1); border:1px solid rgba(255,90,165,0.35); border-radius:10px; padding:0.6rem 0.9rem; display:flex; align-items:center; gap:0.6rem;">
                <div style="width:8px; height:8px; border-radius:50%; background:var(--pink-accent); box-shadow:0 0 10px var(--pink-accent);"></div>
                <span style="font-size:0.75rem; color:#ffffff;">Core temperature nominal at 4.2 Kelvin</span>
              </div>`
          },
          {
            id: 'loaders',
            name: 'Plasma Dual-Ring Loader',
            rule: 'Use during indeterminate asynchronous telemetry or neural calibration cycles.',

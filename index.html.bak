<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  <!-- Content Security Policy: Strict & Secure (Zero unsafe-eval, zero string evaluation) -->
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self';">

  <title>Nikneuron — Interfaces for the world that's coming</title>
  <meta name="description" content="Nikneuron: Systematic futuristic UI/UX design system anchored around an interactive 3D energy cube floating in deep space nebula. Explore 6 foundational interface paradigms.">

  <!-- Preload Nebula Background -->
  <link rel="preload" href="nebula.jpg" as="image">

  <!-- Google Fonts: Unbounded & Manrope -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&family=Unbounded:wght@300;400;600;700;800;900&display=swap" rel="stylesheet">

  <!-- Pinned Three.js from cdnjs -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>

  <style>
    /* ==========================================================================
       DESIGN TOKENS & SYSTEM VARIABLES
       ========================================================================== */
    :root {
      --void-bg: #050612;
      --void-deep: #020308;
      --void-surface: rgba(10, 20, 50, 0.45);
      --void-surface-hover: rgba(16, 28, 68, 0.65);
      
      --cyan-electric: #4fd8ff;
      --cyan-glow: rgba(79, 216, 255, 0.45);
      --cyan-subtle: rgba(79, 216, 255, 0.12);
      
      --ice-white: #e8fbff;
      --blue-deep: #0a3cff;
      --pink-accent: #ff5aa5;
      --pink-glow: rgba(255, 90, 165, 0.5);

      --text-primary: #ffffff;
      --text-secondary: #a3b2d6;
      --text-dim: #64749a;
      
      --border-glass: rgba(79, 216, 255, 0.22);
      --border-active: rgba(79, 216, 255, 0.75);
      
      --font-display: 'Unbounded', -apple-system, sans-serif;
      --font-body: 'Manrope', -apple-system, BlinkMacSystemFont, sans-serif;
      --ease-elastic: cubic-bezier(0.16, 1, 0.3, 1);
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html, body {
      width: 100%;
      height: 100%;
      overflow: hidden;
      background-color: var(--void-bg);
      color: var(--text-primary);
      font-family: var(--font-body);
      font-size: 15px;
      line-height: 1.5;
      user-select: none;
      -webkit-user-select: none;
    }

    ::selection {
      background: var(--pink-accent);
      color: var(--void-bg);
    }

    button:focus-visible, input:focus-visible, a:focus-visible {
      outline: 2px solid var(--cyan-electric);
      outline-offset: 3px;
    }

    button {
      font-family: inherit;
      border: none;
      background: none;
      cursor: pointer;
      color: inherit;
    }

    input, select, textarea {
      font-family: inherit;
      color: inherit;
    }

    /* ==========================================================================
       NEBULA BACKGROUND SYSTEM & PARALLAX STARS
       ========================================================================== */
    .nebula-scene-wrap {
      position: fixed;
      inset: -5%;
      width: 110%;
      height: 110%;
      z-index: 0;
      pointer-events: none;
      transition: filter 0.5s var(--ease-elastic), transform 0.2s ease-out;
      transform: translate3d(0, 0, 0);
    }

    body.face-open .nebula-scene-wrap {
      filter: blur(6px) brightness(0.4);
    }

    .nebula-image-layer {
      position: absolute;
      inset: 0;
      background: url('nebula.jpg') center/cover no-repeat fixed;
      animation: nebulaDrift 60s ease-in-out infinite alternate;
      will-change: transform;
    }

    @keyframes nebulaDrift {
      0% {
        transform: scale(1.00) translate(0, 0);
      }
      50% {
        transform: scale(1.04) translate(-0.8%, 0.5%);
      }
      100% {
        transform: scale(1.08) translate(0.8%, -0.8%);
      }
    }

    .nebula-fallback-gradient {
      position: absolute;
      inset: 0;
      background: 
        radial-gradient(circle at 60% 40%, rgba(42, 16, 96, 0.75) 0%, transparent 55%),
        radial-gradient(circle at 35% 65%, rgba(10, 26, 92, 0.8) 0%, transparent 60%),
        radial-gradient(circle at 50% 50%, #0a1a5c 0%, #050612 85%);
      opacity: 0;
      transition: opacity 0.5s ease;
    }

    body.nebula-fallback .nebula-fallback-gradient {
      opacity: 1;
    }

    #twinkle-stars-canvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
    }

    .cube-nebula-halo {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 650px;
      height: 650px;
      border-radius: 50%;
      background: radial-gradient(circle at 50% 50%, rgba(79, 216, 255, 0.28) 0%, rgba(10, 60, 255, 0.14) 40%, transparent 70%);
      filter: blur(40px);
      pointer-events: none;
      animation: haloBreath 5s ease-in-out infinite alternate;
      mix-blend-mode: screen;
    }

    @keyframes haloBreath {
      0% { transform: translate(-50%, -50%) scale(0.92); opacity: 0.7; }
      100% { transform: translate(-50%, -50%) scale(1.15); opacity: 1; }
    }

    .nebula-dark-overlay {
      position: absolute;
      inset: 0;
      background: rgba(5, 6, 18, 0.45);
      pointer-events: none;
    }

    .nebula-vignette {
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at 50% 50%, transparent 30%, rgba(5, 6, 18, 0.65) 70%, rgba(2, 3, 8, 0.94) 100%);
      pointer-events: none;
    }

    #shooting-star-canvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 1;
    }

    /* Three.js 3D Viewport */
    .viewport-canvas-container {
      position: absolute;
      inset: 0;
      z-index: 2;
      cursor: grab;
    }

    .viewport-canvas-container:active {
      cursor: grabbing;
    }

    #webgl-cube-canvas {
      width: 100%;
      height: 100%;
      display: block;
    }

    /* Cube Floating Label on Hover */
    #face-hover-tooltip {
      position: fixed;
      pointer-events: none;
      z-index: 60;
      font-family: var(--font-display);
      font-size: 0.85rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #ffffff;
      background: rgba(10, 20, 50, 0.85);
      border: 1px solid var(--cyan-electric);
      box-shadow: 0 0 25px rgba(79, 216, 255, 0.5), inset 0 0 10px rgba(79, 216, 255, 0.2);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      padding: 0.45rem 1rem;
      border-radius: 999px;
      transform: translate(-50%, -140%);
      opacity: 0;
      transition: opacity 0.2s ease, transform 0.2s ease;
      white-space: nowrap;
    }

    #face-hover-tooltip.visible {
      opacity: 1;
      transform: translate(-50%, -160%);
    }

    /* Hero Interaction Hint Under the Cube */
    .hero-cube-hint {
      position: fixed;
      bottom: 5.6rem;
      left: 50%;
      transform: translateX(-50%);
      z-index: 15;
      font-size: 0.82rem;
      font-weight: 500;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--cyan-electric);
      background: rgba(10, 20, 50, 0.55);
      border: 1px solid rgba(79, 216, 255, 0.25);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      padding: 0.5rem 1.4rem;
      border-radius: 999px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5), 0 0 18px rgba(79, 216, 255, 0.2);
      pointer-events: none;
      transition: opacity 0.8s ease, transform 0.8s ease;
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }

    .hero-cube-hint.faded {
      opacity: 0;
      transform: translateX(-50%) translateY(15px);
      pointer-events: none;
    }

    .hero-cube-hint .hint-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--pink-accent);
      box-shadow: 0 0 8px var(--pink-accent);
      animation: pulseHint 2s infinite;
    }

    @keyframes pulseHint {
      0%, 100% { transform: scale(1); opacity: 0.8; }
      50% { transform: scale(1.6); opacity: 1; }
    }

    /* ==========================================================================
       OPENING INTRO OVERLAY
       ========================================================================== */
    #intro-overlay {
      position: fixed;
      inset: 0;
      z-index: 99999;
      background: transparent;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      transition: opacity 1.2s var(--ease-elastic), visibility 1.2s;
    }

    #intro-overlay.fade-out {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    .door {
      position: absolute;
      top: 0;
      bottom: 0;
      width: 50.3%;
      background: #020308;
      z-index: 5;
      transition: transform 1.25s cubic-bezier(0.86, 0, 0.07, 1);
      box-shadow: 0 0 50px rgba(0, 0, 0, 0.95);
    }
    .door-left {
      left: 0;
      border-right: 1px solid rgba(79, 216, 255, 0.25);
    }
    .door-right {
      right: 0;
      border-left: 1px solid rgba(79, 216, 255, 0.25);
    }
    #intro-overlay.split .door-left {
      transform: translateX(-101%);
    }
    #intro-overlay.split .door-right {
      transform: translateX(101%);
    }

    .laser-container {
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: 10;
      display: flex;
      justify-content: center;
    }

    .laser-beam {
      position: absolute;
      top: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 3px;
      height: 0%;
      background: #ffffff;
      box-shadow: 
        0 0 4px #ffffff,
        0 0 14px var(--cyan-electric),
        0 0 35px var(--cyan-electric),
        0 0 65px var(--blue-deep);
      transition: height 1.1s cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    .laser-flare {
      position: absolute;
      left: 50%;
      width: 8px;
      height: 8px;
      background: #ffffff;
      border-radius: 50%;
      transform: translate(-50%, -50%);
      box-shadow: 
        0 0 25px 10px #ffffff,
        0 0 60px 25px var(--cyan-electric),
        0 0 100px 50px var(--blue-deep);
      opacity: 0;
      transition: opacity 0.2s ease;
    }

    .laser-flash {
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at 50% 100%, rgba(255, 255, 255, 0.95) 0%, rgba(79, 216, 255, 0.6) 35%, transparent 75%);
      opacity: 0;
      z-index: 12;
      pointer-events: none;
      transition: opacity 0.35s ease;
    }

    .intro-chamber {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      z-index: 2;
      text-align: center;
      background: radial-gradient(circle at 50% 50%, rgba(10, 26, 92, 0.35) 0%, rgba(2, 3, 8, 0.5) 80%);
    }

    .intro-cube-ignite {
      width: 90px;
      height: 90px;
      position: relative;
      margin-bottom: 2.2rem;
      transform: scale(0.1);
      opacity: 0;
      transition: transform 1.5s var(--ease-elastic), opacity 1s ease;
    }

    #intro-overlay.ignite .intro-cube-ignite {
      transform: scale(1) rotate(45deg);
      opacity: 1;
    }

    .intro-cube-box {
      width: 100%;
      height: 100%;
      border: 2px solid var(--cyan-electric);
      background: rgba(79, 216, 255, 0.15);
      box-shadow: 0 0 35px var(--cyan-electric), inset 0 0 25px var(--blue-deep);
      animation: spinIntroCube 6s linear infinite;
    }

    @keyframes spinIntroCube {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }

    .brand-title {
      font-family: var(--font-display);
      font-size: clamp(2.4rem, 6.5vw, 4.4rem);
      font-weight: 800;
      letter-spacing: 0.38em;
      margin-left: 0.38em;
      display: flex;
      justify-content: center;
      color: #ffffff;
      text-shadow: 0 0 28px rgba(79, 216, 255, 0.65);
      margin-bottom: 1.4rem;
    }

    .brand-letter {
      display: inline-block;
      opacity: 0;
      transform: translateY(32px) scale(0.85);
      filter: blur(16px);
      transition: all 0.75s var(--ease-elastic);
    }

    .brand-letter.active {
      opacity: 1;
      transform: translateY(0) scale(1);
      filter: blur(0);
    }

    .brand-tagline {
      font-family: var(--font-body);
      font-size: clamp(0.95rem, 2vw, 1.35rem);
      font-weight: 300;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--cyan-electric);
      opacity: 0;
      transform: translateY(18px);
      transition: opacity 0.9s ease 0.2s, transform 0.9s ease 0.2s;
    }

    .brand-tagline.active {
      opacity: 0.95;
      transform: translateY(0);
      text-shadow: 0 0 20px rgba(79, 216, 255, 0.5);
    }

    .skip-intro-btn {
      position: absolute;
      top: 2rem;
      right: 2.5rem;
      z-index: 100;
      color: var(--text-secondary);
      font-size: 0.8rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      padding: 0.65rem 1.4rem;
      border: 1px solid rgba(79, 216, 255, 0.25);
      border-radius: 999px;
      background: rgba(10, 20, 50, 0.65);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      display: flex;
      align-items: center;
      gap: 0.65rem;
      transition: all 0.3s ease;
    }

    .skip-intro-btn:hover {
      color: #ffffff;
      border-color: var(--cyan-electric);
      box-shadow: 0 0 20px rgba(79, 216, 255, 0.35);
      transform: translateY(-1px);
    }

    .skip-progress {
      width: 14px;
      height: 14px;
      transform: rotate(-90deg);
    }
    .skip-progress circle {
      fill: none;
      stroke-width: 2.5;
    }
    .skip-progress .bg { stroke: rgba(255, 255, 255, 0.15); }
    .skip-progress .bar {
      stroke: var(--cyan-electric);
      stroke-dasharray: 38;
      stroke-dashoffset: 0;
      transition: stroke-dashoffset 0.1s linear;
    }

    /* ==========================================================================
       TOP INTERFACE & GLOWING SEARCH BAR
       ========================================================================== */
    .top-header {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 100;
      padding: 1.6rem 2.8rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      pointer-events: none;
    }

    .top-header > * {
      pointer-events: auto;
    }

    .site-brand {
      display: flex;
      align-items: center;
      gap: 0.8rem;
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1.2rem;
      letter-spacing: 0.15em;
      color: #ffffff;
      text-decoration: none;
    }

    .site-brand-cube-icon {
      width: 22px;
      height: 22px;
      border: 1.5px solid var(--cyan-electric);
      border-radius: 4px;
      box-shadow: 0 0 10px var(--cyan-electric);
      transform: rotate(45deg);
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .site-brand-cube-icon::after {
      content: '';
      width: 6px;
      height: 6px;
      background: var(--pink-accent);
      border-radius: 50%;
      box-shadow: 0 0 8px var(--pink-accent);
    }

    .search-wrapper {
      position: relative;
      width: 100%;
      max-width: 460px;
    }

    .search-input-box {
      width: 100%;
      background: rgba(10, 20, 50, 0.45);
      border: 1px solid var(--border-glass);
      border-radius: 999px;
      padding: 0.75rem 1.4rem;
      padding-left: 2.8rem;
      padding-right: 4.8rem;
      color: #ffffff;
      font-size: 0.92rem;
      letter-spacing: 0.03em;
      outline: none;
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      transition: all 0.35s ease;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4), 0 0 15px rgba(79, 216, 255, 0.08);
    }

    .search-input-box:focus {
      border-color: var(--cyan-electric);
      background: rgba(10, 20, 50, 0.75);
      box-shadow: 0 10px 35px rgba(0, 0, 0, 0.6), 0 0 25px rgba(79, 216, 255, 0.35);
    }

    .search-icon {
      position: absolute;
      left: 1rem;
      top: 50%;
      transform: translateY(-50%);
      width: 16px;
      height: 16px;
      stroke: var(--cyan-electric);
      pointer-events: none;
    }

    .search-shortcut-badge {
      position: absolute;
      right: 0.9rem;
      top: 50%;
      transform: translateY(-50%);
      font-family: var(--font-display);
      font-size: 0.72rem;
      color: var(--text-dim);
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 6px;
      padding: 0.15rem 0.5rem;
      pointer-events: none;
      letter-spacing: 0.05em;
    }

    .search-dropdown {
      position: absolute;
      top: calc(100% + 10px);
      left: 0;
      right: 0;
      background: rgba(10, 20, 50, 0.85);
      border: 1px solid var(--border-glass);
      border-radius: 18px;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.8), 0 0 30px rgba(79, 216, 255, 0.15);
      backdrop-filter: blur(25px);
      -webkit-backdrop-filter: blur(25px);
      max-height: 380px;
      overflow-y: auto;
      display: none;
      flex-direction: column;
      z-index: 1000;
      padding: 0.6rem;
    }

    .search-dropdown.open {
      display: flex;
    }

    .search-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.75rem 1rem;
      border-radius: 10px;
      cursor: pointer;
      transition: all 0.2s ease;
      color: var(--text-primary);
    }

    .search-item:hover, .search-item.highlighted {
      background: rgba(79, 216, 255, 0.14);
      border: 1px solid rgba(79, 216, 255, 0.3);
    }

    .search-item-info {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
    }

    .search-item-name {
      font-weight: 600;
      font-size: 0.9rem;
      color: #ffffff;
    }

    .search-item-desc {
      font-size: 0.78rem;
      color: var(--text-secondary);
    }

    .search-item-face-pill {
      font-size: 0.72rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      padding: 0.25rem 0.65rem;
      border-radius: 999px;
      background: rgba(79, 216, 255, 0.12);
      border: 1px solid rgba(79, 216, 255, 0.28);
      color: var(--cyan-electric);
    }

    .search-empty-state {
      padding: 1.8rem 1.2rem;
      text-align: center;
    }

    .search-empty-title {
      font-family: var(--font-display);
      font-size: 0.95rem;
      color: #ffffff;
      margin-bottom: 0.4rem;
    }

    .search-empty-sub {
      font-size: 0.8rem;
      color: var(--text-secondary);
      margin-bottom: 1rem;
    }

    .search-suggest-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      justify-content: center;
    }

    .suggest-chip {
      font-size: 0.75rem;
      color: var(--cyan-electric);
      background: rgba(79, 216, 255, 0.1);
      border: 1px solid rgba(79, 216, 255, 0.25);
      padding: 0.3rem 0.7rem;
      border-radius: 999px;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .suggest-chip:hover {
      background: rgba(79, 216, 255, 0.25);
      color: #ffffff;
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .action-icon-btn {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.6rem 1.1rem;
      border-radius: 999px;
      background: rgba(10, 20, 50, 0.45);
      border: 1px solid var(--border-glass);
      font-size: 0.82rem;
      color: var(--text-secondary);
      letter-spacing: 0.05em;
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      transition: all 0.3s ease;
    }

    .action-icon-btn:hover {
      color: var(--cyan-electric);
      border-color: var(--cyan-electric);
      box-shadow: 0 0 15px rgba(79, 216, 255, 0.25);
    }

    /* ==========================================================================
       BOTTOM HUD: QUICK FACE DOCK
       ========================================================================== */
    .bottom-hud {
      position: fixed;
      bottom: 2rem;
      left: 50%;
      transform: translateX(-50%);
      z-index: 100;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.8rem;
      pointer-events: none;
    }

    .bottom-hud > * {
      pointer-events: auto;
    }

    .face-dock {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.4rem 0.6rem;
      background: rgba(10, 20, 50, 0.55);
      border: 1px solid var(--border-glass);
      border-radius: 999px;
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      box-shadow: 0 15px 35px rgba(0, 0, 0, 0.6), 0 0 20px rgba(79, 216, 255, 0.12);
    }

    .dock-btn {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.55rem 1rem;
      border-radius: 999px;
      font-size: 0.8rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      color: var(--text-secondary);
      transition: all 0.3s var(--ease-elastic);
    }

    .dock-btn:hover {
      color: #ffffff;
      background: rgba(79, 216, 255, 0.15);
    }

    .dock-btn.active {
      color: #050612;
      background: var(--cyan-electric);
      box-shadow: 0 0 18px var(--cyan-electric);
    }

    .dock-indicator {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: currentColor;
    }

    /* ==========================================================================
       COMPONENT INSPECTOR / FACE DETAIL PANEL (WITH COUNTER & NAV ARROWS)
       ========================================================================== */
    .face-inspector {
      position: fixed;
      inset: 0;
      z-index: 500;
      background: rgba(4, 5, 15, 0.6);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      display: flex;
      justify-content: flex-end;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.45s var(--ease-elastic), visibility 0.45s;
    }

    .face-inspector.open {
      opacity: 1;
      visibility: visible;
    }

    .inspector-sheet {
      width: 100%;
      max-width: 820px;
      height: 100%;
      background: linear-gradient(165deg, rgba(10, 20, 50, 0.72) 0%, rgba(6, 10, 28, 0.82) 100%);
      border-left: 1px solid var(--border-glass);
      box-shadow: -25px 0 80px rgba(0, 0, 0, 0.9), -5px 0 35px rgba(79, 216, 255, 0.15);
      backdrop-filter: blur(28px);
      -webkit-backdrop-filter: blur(28px);
      display: flex;
      flex-direction: column;
      transform: translateX(100%);
      transition: transform 0.5s var(--ease-elastic);
      overflow: hidden;
    }

    .face-inspector.open .inspector-sheet {
      transform: translateX(0);
    }

    .inspector-header {
      padding: 2rem 2.6rem 1.4rem 2.6rem;
      border-bottom: 1px solid rgba(79, 216, 255, 0.15);
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 1.5rem;
      background: rgba(10, 20, 50, 0.35);
    }

    .inspector-title-group {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }

    .inspector-meta-row {
      display: flex;
      align-items: center;
      gap: 1.2rem;
    }

    .inspector-face-counter {
      font-family: var(--font-display);
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--cyan-electric);
      background: rgba(79, 216, 255, 0.12);
      border: 1px solid rgba(79, 216, 255, 0.25);
      border-radius: 999px;
      padding: 0.2rem 0.75rem;
      letter-spacing: 0.1em;
    }

    .face-arrow-nav {
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }

    .face-nav-btn {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid var(--border-glass);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--text-secondary);
      transition: all 0.25s ease;
    }

    .face-nav-btn:hover {
      background: var(--cyan-electric);
      color: var(--void-bg);
      border-color: var(--cyan-electric);
      box-shadow: 0 0 12px var(--cyan-electric);
    }

    .inspector-face-eyebrow {
      font-family: var(--font-display);
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--pink-accent);
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .inspector-face-eyebrow::before {
      content: '';
      width: 10px;
      height: 2px;
      background: var(--pink-accent);
      box-shadow: 0 0 8px var(--pink-accent);
    }

    .inspector-face-title {
      font-family: var(--font-display);
      font-size: clamp(1.8rem, 3.2vw, 2.4rem);
      font-weight: 800;
      color: #ffffff;
      letter-spacing: -0.01em;
      text-shadow: 0 2px 10px rgba(0, 0, 0, 0.6);
    }

    .inspector-face-desc {
      color: var(--text-secondary);
      font-size: 0.95rem;
      line-height: 1.6;
      font-weight: 300;
      max-width: 520px;
      text-shadow: 0 1px 4px rgba(0, 0, 0, 0.8);
    }

    .back-to-cube-btn {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.7rem 1.3rem;
      border-radius: 999px;
      background: rgba(79, 216, 255, 0.15);
      border: 1px solid var(--cyan-electric);
      color: #ffffff;
      font-family: var(--font-display);
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.05em;
      box-shadow: 0 0 20px rgba(79, 216, 255, 0.25);
      transition: all 0.3s ease;
      white-space: nowrap;
    }

    .back-to-cube-btn:hover {
      background: var(--cyan-electric);
      color: var(--void-bg);
      box-shadow: 0 0 30px rgba(79, 216, 255, 0.6);
      transform: translateY(-2px);
    }

    .inspector-body {
      flex: 1;
      overflow-y: auto;
      padding: 2.2rem 2.6rem;
      display: flex;
      flex-direction: column;
      gap: 2.5rem;
    }

    .inspector-body::-webkit-scrollbar {
      width: 6px;
    }
    .inspector-body::-webkit-scrollbar-thumb {
      background: rgba(79, 216, 255, 0.3);
      border-radius: 999px;
    }

    .component-cards-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 1.8rem;
    }

    .component-card {
      background: rgba(10, 20, 50, 0.45);
      border: 1px solid var(--border-glass);
      border-radius: 18px;
      padding: 1.6rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 1.4rem;
      transition: all 0.35s ease;
      position: relative;
      overflow: hidden;
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
    }

    .component-card:hover {
      border-color: rgba(79, 216, 255, 0.55);
      background: rgba(16, 28, 68, 0.65);
      transform: translateY(-3px);
      box-shadow: 0 15px 35px rgba(0, 0, 0, 0.5), 0 0 25px rgba(79, 216, 255, 0.15);
    }

    .component-card.search-target {
      border-color: var(--pink-accent) !important;
      box-shadow: 0 0 30px rgba(255, 90, 165, 0.5) !important;
      animation: cardPulseTarget 2.2s infinite;
    }

    @keyframes cardPulseTarget {
      0%, 100% { box-shadow: 0 0 20px rgba(255, 90, 165, 0.4); }
      50% { box-shadow: 0 0 45px rgba(255, 90, 165, 0.85); }
    }

    .card-header-info {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }

    .card-top-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.8rem;
    }

    .comp-name {
      font-family: var(--font-display);
      font-size: 1.05rem;
      font-weight: 700;
      color: #ffffff;
      letter-spacing: -0.01em;
      text-shadow: 0 1px 4px rgba(0, 0, 0, 0.8);
    }

    .copy-code-btn {
      display: flex;
      align-items: center;
      gap: 0.35rem;
      padding: 0.3rem 0.75rem;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid var(--border-glass);
      font-size: 0.72rem;
      font-weight: 600;
      color: var(--cyan-electric);
      transition: all 0.25s ease;
      white-space: nowrap;
    }

    .copy-code-btn:hover {
      background: var(--cyan-electric);
      color: var(--void-bg);
      border-color: var(--cyan-electric);
      box-shadow: 0 0 12px var(--cyan-electric);
    }

    .comp-rule {
      font-size: 0.82rem;
      color: var(--text-secondary);
      line-height: 1.5;
      font-weight: 400;
      text-shadow: 0 1px 3px rgba(0, 0, 0, 0.8);
    }

    .comp-interactive-preview {
      background: rgba(5, 7, 20, 0.7);
      border: 1px solid rgba(79, 216, 255, 0.15);
      border-radius: 12px;
      padding: 1.4rem;
      min-height: 110px;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
    }

    .comp-interactive-preview input[type="text"]:focus {
      border-color: var(--cyan-electric) !important;
      box-shadow: 0 0 10px rgba(79, 216, 255, 0.3);
    }

    /* Demo Components Styling */
    .demo-btn-primary {
      font-family: var(--font-display);
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.05em;
      padding: 0.65rem 1.4rem;
      border-radius: 999px;
      color: #050612;
      background: var(--cyan-electric);
      box-shadow: 0 0 15px rgba(79, 216, 255, 0.4);
      transition: all 0.25s ease;
    }
    .demo-btn-primary:hover {
      background: #ffffff;
      box-shadow: 0 0 25px rgba(79, 216, 255, 0.7);
      transform: scale(1.03);
    }
    .demo-btn-primary:active {
      transform: scale(0.97);
    }

    .demo-btn-ghost {
      font-family: var(--font-display);
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.05em;
      padding: 0.65rem 1.2rem;
      border-radius: 999px;
      color: var(--text-primary);
      border: 1px solid var(--border-glass);
      background: rgba(255, 255, 255, 0.05);
      transition: all 0.25s ease;
    }
    .demo-btn-ghost:hover {
      border-color: var(--pink-accent);
      color: var(--pink-accent);
      box-shadow: 0 0 15px rgba(255, 90, 165, 0.3);
    }

    .quantum-toggle-track {
      width: 58px;
      height: 30px;
      background: rgba(255, 255, 255, 0.12);
      border: 1px solid var(--border-glass);
      border-radius: 999px;
      position: relative;
      cursor: pointer;
      transition: all 0.3s ease;
    }
    .quantum-toggle-track.active {
      background: rgba(79, 216, 255, 0.3);
      border-color: var(--cyan-electric);
      box-shadow: 0 0 18px rgba(79, 216, 255, 0.4);
    }
    .quantum-toggle-thumb {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background: var(--text-secondary);
      position: absolute;
      top: 3px;
      left: 4px;
      transition: all 0.3s var(--ease-elastic);
    }
    .quantum-toggle-track.active .quantum-toggle-thumb {
      left: 30px;
      background: var(--cyan-electric);
      box-shadow: 0 0 12px var(--cyan-electric);
    }

    .flux-slider-wrap {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }
    .flux-slider-header {
      display: flex;
      justify-content: space-between;
      font-size: 0.75rem;
      color: var(--text-secondary);
    }
    .flux-slider-val {
      font-family: var(--font-display);
      color: var(--cyan-electric);
      font-weight: 700;
    }
    .flux-slider-input {
      -webkit-appearance: none;
      width: 100%;
      height: 6px;
      background: rgba(255, 255, 255, 0.15);
      border-radius: 999px;
      outline: none;
    }
    .flux-slider-input::-webkit-slider-thumb {
      -webkit-appearance: none;
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: var(--cyan-electric);
      box-shadow: 0 0 12px var(--cyan-electric);
      cursor: pointer;
      transition: transform 0.2s;
    }

    .demo-segmented-tabs {
      display: flex;
      background: rgba(10, 20, 50, 0.85);
      border: 1px solid var(--border-glass);
      border-radius: 999px;
      padding: 0.3rem;
      gap: 0.3rem;
    }
    .demo-tab-item {
      padding: 0.4rem 0.9rem;
      border-radius: 999px;
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--text-secondary);
      transition: all 0.25s ease;
    }
    .demo-tab-item.active {
      color: #050612;
      background: var(--cyan-electric);
      box-shadow: 0 0 12px var(--cyan-electric);
    }

    .toast-container {
      position: fixed;
      top: 5.5rem;
      right: 2.5rem;
      z-index: 10000;
      display: flex;
      flex-direction: column;
      gap: 0.8rem;
      pointer-events: none;
    }
    .toast-pill {
      background: rgba(10, 20, 50, 0.92);
      border: 1px solid var(--cyan-electric);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.8), 0 0 25px rgba(79, 216, 255, 0.4);
      border-radius: 12px;
      padding: 0.8rem 1.4rem;
      display: flex;
      align-items: center;
      gap: 0.8rem;
      color: #ffffff;
      font-size: 0.85rem;
      animation: toastIn 0.35s var(--ease-elastic);
      pointer-events: auto;
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
    }
    @keyframes toastIn {
      from { transform: translateX(60px); opacity: 0; }
      to { transform: translateX(0); opacity: 1; }
    }

    .telemetry-mini-grid {
      width: 100%;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .telemetry-val-box {
      display: flex;
      flex-direction: column;
    }
    .telemetry-val-title {
      font-size: 0.68rem;
      color: var(--text-dim);
      text-transform: uppercase;
      letter-spacing: 0.1em;
    }
    .telemetry-val-number {
      font-family: var(--font-display);
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--cyan-electric);
    }
    .sparkline-svg {
      width: 120px;
      height: 38px;
    }

    .plasma-spinner {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      border: 2px solid rgba(79, 216, 255, 0.2);
      border-top-color: var(--cyan-electric);
      border-bottom-color: var(--pink-accent);
      animation: spinLoader 1.2s cubic-bezier(0.5, 0, 0.5, 1) infinite;
      box-shadow: 0 0 15px rgba(79, 216, 255, 0.35);
    }
    @keyframes spinLoader {
      100% { transform: rotate(360deg); }
    }

    .voice-bars {
      display: flex;
      align-items: center;
      gap: 4px;
      height: 40px;
    }
    .voice-bar-col {
      width: 3px;
      background: linear-gradient(to top, var(--cyan-electric), var(--pink-accent));
      border-radius: 999px;
      animation: voicePulse 1.4s ease-in-out infinite alternate;
    }
    @keyframes voicePulse {
      0% { height: 8px; }
      100% { height: 36px; }
    }

    .swatch-group {
      display: flex;
      gap: 0.6rem;
      flex-wrap: wrap;
    }
    .swatch-pill {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.35rem 0.7rem;
      border-radius: 8px;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid var(--border-glass);
      font-size: 0.75rem;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .swatch-pill:hover {
      border-color: #ffffff;
      transform: translateY(-2px);
    }
    .swatch-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      box-shadow: 0 0 8px currentColor;
    }

    .cmd-palette-box {
      width: 100%;
      background: rgba(10, 20, 50, 0.95);
      border: 1px solid var(--cyan-electric);
      border-radius: 12px;
      padding: 0.8rem 1rem;
      display: flex;
      align-items: center;
      gap: 0.8rem;
      box-shadow: 0 0 20px rgba(79, 216, 255, 0.2);
    }
    .cmd-palette-box input {
      background: transparent;
      border: none;
      outline: none;
      color: #ffffff;
      font-size: 0.85rem;
      width: 100%;
    }

    /* Motion easing animation */
    .motion-easing-ball {
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: var(--cyan-electric);
      box-shadow: 0 0 10px var(--cyan-electric);
      position: absolute;
      top: -2px;
      animation: easingDemo 2s cubic-bezier(0.16, 1, 0.3, 1) infinite alternate;
    }
    @keyframes easingDemo {
      0% { left: 0%; }
      100% { left: calc(100% - 12px); }
    }

    @media (max-width: 900px) {
      .top-header {
        padding: 1.2rem 1.4rem;
        flex-direction: column;
        gap: 0.9rem;
      }
      .search-wrapper {
        max-width: 100%;
      }
      .site-brand {
        align-self: flex-start;
      }
      .header-actions {
        display: none;
      }
      .inspector-sheet {
        max-width: 100%;
        height: 85%;
        border-left: none;
        border-top: 1px solid var(--border-glass);
        border-radius: 24px 24px 0 0;
        transform: translateY(100%);
      }
      .face-inspector.open .inspector-sheet {
        transform: translateY(0);
      }
      .inspector-header {
        padding: 1.6rem 1.4rem 1.2rem 1.4rem;
      }
      .inspector-body {
        padding: 1.4rem;
      }
      .component-cards-grid {
        grid-template-columns: 1fr;
      }
      .bottom-hud {
        bottom: 1.2rem;
        width: calc(100% - 2rem);
      }
      .face-dock {
        width: 100%;
        overflow-x: auto;
        justify-content: flex-start;
        padding: 0.4rem;
      }
      .hero-cube-hint {
        bottom: 5.2rem;
        font-size: 0.72rem;
        padding: 0.45rem 1rem;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      * {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
      .nebula-image-layer {
        animation: none !important;
      }
      #intro-overlay {
        display: none !important;
      }
    }
  </style>
</head>
<body>

  <!-- ==========================================================================
       1. NEBULA BACKGROUND SYSTEM
       ========================================================================== */
  -->
  <div class="nebula-scene-wrap" id="nebula-scene-wrap">
    <div class="nebula-image-layer" id="nebula-img-layer"></div>
    <div class="nebula-fallback-gradient" id="nebula-fallback-layer"></div>
    <canvas id="twinkle-stars-canvas"></canvas>
    <div class="cube-nebula-halo"></div>
    <canvas id="shooting-star-canvas"></canvas>
    <div class="nebula-dark-overlay"></div>
    <div class="nebula-vignette"></div>
  </div>

  <!-- ==========================================================================
       2. THREE.JS 3D CANVAS
       ========================================================================== */
  -->
  <div class="viewport-canvas-container" id="canvas-container">
    <canvas id="webgl-cube-canvas"></canvas>
  </div>

  <div id="face-hover-tooltip"></div>

  <div class="hero-cube-hint" id="hero-cube-hint">
    <span class="hint-dot"></span>
    <span>Drag to rotate · Click a face to explore · Press / to search</span>
  </div>

  <div class="toast-container" id="toast-container"></div>

  <!-- ==========================================================================
       3. OPENING INTRO OVERLAY
       ========================================================================== */
  -->
  <div id="intro-overlay" role="dialog" aria-label="Nikneuron intro sequence">
    <button class="skip-intro-btn" id="skip-intro" aria-label="Skip intro to cube">
      <span>Skip Intro</span>
      <svg class="skip-progress" viewBox="0 0 16 16">
        <circle class="bg" cx="8" cy="8" r="6" />
        <circle class="bar" id="skip-bar" cx="8" cy="8" r="6" />
      </svg>
    </button>

    <div class="laser-container">
      <div class="laser-beam" id="laser-beam"></div>
      <div class="laser-flare" id="laser-flare"></div>
      <div class="laser-flash" id="laser-flash"></div>
    </div>

    <div class="door door-left" id="door-left"></div>
    <div class="door door-right" id="door-right"></div>

    <div class="intro-chamber">
      <div class="intro-cube-ignite" id="intro-cube-ignite">
        <div class="intro-cube-box"></div>
      </div>

      <h1 class="brand-title" id="brand-title" aria-label="Nikneuron">
        <span class="brand-letter">N</span>
        <span class="brand-letter">I</span>
        <span class="brand-letter">K</span>
        <span class="brand-letter">N</span>
        <span class="brand-letter">E</span>
        <span class="brand-letter">U</span>
        <span class="brand-letter">R</span>
        <span class="brand-letter">O</span>
        <span class="brand-letter">N</span>
      </h1>

      <p class="brand-tagline" id="brand-tagline">Interfaces for the world that's coming</p>
    </div>
  </div>

  <!-- ==========================================================================
       4. TOP HEADER & GLOWING SEARCH BAR
       ========================================================================== */
  -->
  <header class="top-header">
    <a href="#" class="site-brand" id="brand-home-btn" title="Reset to Center Cube View">
      <div class="site-brand-cube-icon"></div>
      <span>NIKNEURON</span>
    </a>

    <div class="search-wrapper">
      <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke-width="2">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input 
        type="text" 
        id="global-search-input" 
        class="search-input-box" 
        placeholder="Search components or faces (e.g. toggle, voice, card)..." 
        autocomplete="off"
        aria-label="Search components or UI faces"
      >
      <span class="search-shortcut-badge">/</span>

      <div class="search-dropdown" id="search-dropdown" role="listbox"></div>
    </div>

    <div class="header-actions">
      <button class="action-icon-btn" id="replay-intro-btn" title="Replay Opening Laser Beam Intro">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
          <polyline points="1 4 1 10 7 10"></polyline>
          <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
        </svg>
        <span>Laser Intro</span>
      </button>

      <button class="action-icon-btn" id="sound-btn" title="Toggle Synthesizer Audio">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
          <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
          <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>
        </svg>
        <span id="sound-status-text">Audio: On</span>
      </button>
    </div>
  </header>

  <!-- ==========================================================================
       5. BOTTOM HUD: DOCK SELECTOR
       ========================================================================== */
  -->
  <div class="bottom-hud">
    <nav class="face-dock" aria-label="Select Cube Face">
      <button class="dock-btn active" data-face-index="0" title="Inspect Navigation">
        <span class="dock-indicator"></span>
        <span>Navigation</span>
      </button>
      <button class="dock-btn" data-face-index="1" title="Inspect Inputs">
        <span class="dock-indicator"></span>
        <span>Inputs</span>
      </button>
      <button class="dock-btn" data-face-index="2" title="Inspect Feedback">
        <span class="dock-indicator"></span>
        <span>Feedback</span>
      </button>
      <button class="dock-btn" data-face-index="3" title="Inspect Data">
        <span class="dock-indicator"></span>
        <span>Data</span>
      </button>
      <button class="dock-btn" data-face-index="4" title="Inspect Future Interfaces">
        <span class="dock-indicator"></span>
        <span>Future</span>
      </button>
      <button class="dock-btn" data-face-index="5" title="Inspect Foundations">
        <span class="dock-indicator"></span>
        <span>Foundations</span>
      </button>
    </nav>
  </div>

  <!-- ==========================================================================
       6. COMPONENT INSPECTOR SHEET
       ========================================================================== */
  -->
  <aside class="face-inspector" id="face-inspector" role="dialog" aria-modal="true">
    <div class="inspector-sheet">
      <div class="inspector-header">
        <div class="inspector-title-group">
          <div class="inspector-meta-row">
            <span class="inspector-face-eyebrow" id="inspector-eyebrow">Face 01 // Orientation</span>
            <span class="inspector-face-counter" id="inspector-counter">1 / 6</span>
            
            <div class="face-arrow-nav">
              <button class="face-nav-btn" id="prev-face-btn" title="Previous Face (Arrow Left)" aria-label="Previous Face">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polyline points="15 18 9 12 15 6"></polyline>
                </svg>
              </button>
              <button class="face-nav-btn" id="next-face-btn" title="Next Face (Arrow Right)" aria-label="Next Face">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
              </button>
            </div>
          </div>

          <h2 class="inspector-face-title" id="inspector-title">Navigation</h2>
          <p class="inspector-face-desc" id="inspector-desc">
            Structures that orient, route, and contextualize human intent across multidimensional software landscapes.
          </p>
        </div>

        <button class="back-to-cube-btn" id="back-to-cube-btn" title="Return to 3D Cube View (Esc)">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
          <span>Back to Cube</span>
        </button>
      </div>

      <div class="inspector-body" id="inspector-body">
        <div class="component-cards-grid" id="component-cards-grid"></div>
      </div>
    </div>
  </aside>

  <!-- ==========================================================================
       7. JAVASCRIPT: CSP-COMPLIANT ARCHITECTURE
       ========================================================================== */
  -->
  <script>
    /* ==========================================================================
       A. COMPONENT CATALOG (STRICT CSP: ZERO INLINE HANDLERS OR EVALUATION)
       ========================================================================== */
    const FACES_DATA = [
      {
        id: 'navigation',
        name: 'Navigation',
        index: 0,
        eyebrow: 'Face 01 // Orientation',
        desc: 'Spatial and contextual routing components that anchor the human mental model across infinite state planes.',
        euler: { x: 0, y: Math.PI / 2, z: 0 },
        components: [
          {
            id: 'navbars',
            name: 'Floating Pill Navbar',
            rule: 'Use as the persistent top-level anchor for high-level domain transitions.',
            code: `<nav class="nik-pill-nav">\n  <a href="#feed" class="active">Feed</a>\n  <a href="#spatial">Spatial</a>\n  <a href="#nodes">Nodes</a>\n</nav>`,
            render: () => `
              <div style="display:flex; align-items:center; gap:1.2rem; background:rgba(10,20,50,0.65); padding:0.45rem 1rem; border-radius:999px; border:1px solid var(--border-glass);">
                <span style="font-family:var(--font-display); font-size:0.75rem; font-weight:700; color:var(--cyan-electric);">NEXUS</span>
                <div style="display:flex; gap:0.6rem; font-size:0.75rem; color:var(--text-secondary);">
                  <span style="color:#ffffff; font-weight:600;">Feed</span>
                  <span>Spatial</span>
                  <span>Nodes</span>
                </div>
              </div>`
          },
          {
            id: 'tabs',
            name: 'Segmented Sliding Tabs',
            rule: 'Use when partitioning mutually exclusive sub-views within the same context.',
            code: `<div class="segmented-tabs">\n  <button class="tab-item active">2D Flat</button>\n  <button class="tab-item">Holo 3D</button>\n  <button class="tab-item">Neural</button>\n</div>`,
            render: () => `
              <div class="demo-segmented-tabs">
                <button class="demo-tab-item active" data-action="switch-tab" data-tab-index="0">2D Flat</button>
                <button class="demo-tab-item" data-action="switch-tab" data-tab-index="1">Holo 3D</button>
                <button class="demo-tab-item" data-action="switch-tab" data-tab-index="2">Neural</button>
              </div>`
          },
          {
            id: 'breadcrumbs',
            name: 'Holographic Breadcrumbs',
            rule: 'Use in deep multi-tier hierarchies to afford immediate parent jumping.',
            code: `<nav aria-label="Breadcrumb" class="holo-crumbs">\n  <a href="/">Root</a> <span>&gt;</span>\n  <a href="/core">Core</a> <span>&gt;</span>\n  <span class="active">Plasma Mesh</span>\n</nav>`,
            render: () => `
              <div style="display:flex; align-items:center; gap:0.5rem; font-size:0.75rem;">
                <span style="color:var(--text-dim);">Root</span>
                <span style="color:var(--cyan-electric);">&gt;</span>
                <span style="color:var(--text-secondary);">Core</span>
                <span style="color:var(--cyan-electric);">&gt;</span>
                <span style="color:#ffffff; font-weight:600; text-shadow:0 0 8px var(--cyan-electric);">Plasma Mesh</span>
              </div>`
          },
          {
            id: 'dropdowns-menu',
            name: 'Glass Contextual Menu',
            rule: 'Use for progressive disclosure of secondary operations without clutter.',
            code: `<div class="glass-context-menu">\n  <div class="menu-item active">Inspect <span>⌘I</span></div>\n  <div class="menu-item">Calibrate Frequency</div>\n</div>`,
            render: () => `
              <div style="background:rgba(10,20,50,0.85); border:1px solid var(--border-glass); border-radius:10px; padding:0.4rem; display:flex; flex-direction:column; gap:0.3rem; min-width:140px;">
                <div style="padding:0.35rem 0.6rem; font-size:0.75rem; border-radius:6px; color:#ffffff; background:rgba(79,216,255,0.18); display:flex; justify-content:space-between;">
                  <span>Inspect</span> <span style="color:var(--cyan-electric); font-size:0.65rem;">⌘I</span>
                </div>
                <div style="padding:0.35rem 0.6rem; font-size:0.75rem; border-radius:6px; color:var(--text-secondary);">Calibrate</div>
              </div>`
          },
          {
            id: 'command-palette',
            name: 'Omni Command Palette',
            rule: 'Use for power-user keyboard navigation across complex application actions.',
            code: `<div class="omni-command-palette">\n  <span class="prompt">&gt;</span>\n  <input type="text" placeholder="Type command..." value="mesh:render-plasma">\n  <kbd>ESC</kbd>\n</div>`,
            render: () => `
              <div class="cmd-palette-box">
                <span style="color:var(--cyan-electric); font-family:var(--font-display); font-size:0.75rem;">&gt;</span>
                <input type="text" placeholder="Type command..." value="mesh:render-plasma" readonly>
                <span style="font-size:0.65rem; color:var(--text-dim); background:rgba(255,255,255,0.08); padding:0.15rem 0.4rem; border-radius:4px;">ESC</span>
              </div>`
          }
        ]
      },
      {
        id: 'inputs',
        name: 'Inputs',
        index: 1,
        eyebrow: 'Face 02 // Intention',
        desc: 'Direct interaction primitives allowing humans to inject parameters, decisions, and commands into the machine.',
        euler: { x: 0, y: -Math.PI / 2, z: 0 },
        components: [
          {
            id: 'buttons',
            name: 'Kinetic Neon Buttons',
            rule: 'Use for decisive primary commitments with tangible energy feedback.',
            code: `<button class="btn-neon-primary">Engage Flux</button>\n<button class="btn-neon-ghost">Standby</button>`,
            render: () => `
              <div style="display:flex; gap:0.8rem; align-items:center;">
                <button class="demo-btn-primary" data-action="sound-haptic">Engage Flux</button>
                <button class="demo-btn-ghost" data-action="sound-haptic">Standby</button>
              </div>`
          },
          {
            id: 'forms',
            name: 'Biometric Input Field',
            rule: 'Use for capturing structured textual or numerical data with active focus glow.',
            code: `<div class="bio-input-group">\n  <label>Neural Identity</label>\n  <input type="text" placeholder="Enter ID..." value="synapse_087x">\n</div>`,
            render: () => `
              <div style="width:100%; display:flex; flex-direction:column; gap:0.3rem;">
                <label style="font-size:0.68rem; text-transform:uppercase; letter-spacing:0.1em; color:var(--text-dim);">Neural Identity</label>
                <input type="text" value="synapse_087x" style="width:100%; background:rgba(10,20,50,0.6); border:1px solid var(--border-glass); border-radius:8px; padding:0.5rem 0.8rem; color:#ffffff; font-size:0.85rem; outline:none;">
              </div>`

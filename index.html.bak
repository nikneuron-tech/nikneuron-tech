            render: () => `
              <div style="background:rgba(255,255,255,0.06); border-radius:8px; padding:0.5rem 0.8rem; display:flex; align-items:center; justify-content:space-between; width:100%;">
                <span style="font-size:0.75rem; color:var(--text-secondary);">Density</span>
                <span style="font-size:0.75rem; font-weight:700; color:var(--cyan-electric);">Adaptive (Auto)</span>
              </div>`
          }
        ]
      },
      {
        id: 'foundations',
        name: 'Foundations',
        index: 5,
        eyebrow: 'Face 06 // Atomic Substrate',
        desc: 'Core rules of physics, color harmony, typography scales, and motion tokens supporting the Nikneuron universe.',
        euler: { x: 0, y: Math.PI, z: 0 },
        components: [
          {
            id: 'color',
            name: 'Spectra Color Tokens',
            rule: 'Click any token swatch to copy its exact hex value to your system buffer.',
            code: `:root {\n  --void-bg: #050612;\n  --cyan-electric: #4fd8ff;\n  --ice-white: #e8fbff;\n  --blue-deep: #0a3cff;\n  --pink-accent: #ff5aa5;\n}`,
            render: () => `
              <div class="swatch-group">
                <div class="swatch-pill" data-action="copy-hex" data-hex="#050612">
                  <span class="swatch-dot" style="background:#050612; color:#050612;"></span> <span>#050612</span>
                </div>
                <div class="swatch-pill" data-action="copy-hex" data-hex="#4fd8ff">
                  <span class="swatch-dot" style="background:#4fd8ff; color:#4fd8ff;"></span> <span>#4fd8ff</span>
                </div>
                <div class="swatch-pill" data-action="copy-hex" data-hex="#ff5aa5">
                  <span class="swatch-dot" style="background:#ff5aa5; color:#ff5aa5;"></span> <span>#ff5aa5</span>
                </div>
              </div>`
          },
          {
            id: 'typography',
            name: 'Dual-Type Hierarchy',
            rule: 'Unbounded for high-impact display moments; Manrope for fatigue-free body reading.',
            code: `h1, h2, h3 { font-family: 'Unbounded', sans-serif; }\nbody, p { font-family: 'Manrope', sans-serif; }`,
            render: () => `
              <div style="display:flex; flex-direction:column; gap:0.2rem;">
                <span style="font-family:var(--font-display); font-size:0.95rem; font-weight:800; color:#ffffff;">UNBOUNDED 800</span>
                <span style="font-family:var(--font-body); font-size:0.8rem; color:var(--text-secondary);">Manrope Light 300</span>
              </div>`
          },
          {
            id: 'spacing',
            name: '8-Point Quantum Spacing',
            rule: 'Strict exponential spacing grid ensuring proportional spatial rhythm.',
            code: `--space-1: 8px;\n--space-2: 16px;\n--space-3: 24px;\n--space-4: 32px;`,
            render: () => `
              <div style="display:flex; align-items:center; gap:6px;">
                <div style="width:8px; height:18px; background:var(--cyan-electric); opacity:0.3;"></div>
                <div style="width:16px; height:18px; background:var(--cyan-electric); opacity:0.6;"></div>
                <div style="width:24px; height:18px; background:var(--cyan-electric); opacity:0.9;"></div>
                <div style="width:32px; height:18px; background:var(--cyan-electric);"></div>
              </div>`
          },
          {
            id: 'motion',
            name: 'Elastic Inertia Easing',
            rule: 'cubic-bezier(0.16, 1, 0.3, 1) mimicking liquid momentum and soft landings.',
            code: `transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);`,
            render: () => `
              <div style="width:100%; height:8px; background:rgba(255,255,255,0.08); border-radius:999px; position:relative;">
                <div class="motion-easing-ball"></div>
              </div>`
          },
          {
            id: 'icons',
            name: 'Vector Monoline Glyphs',
            rule: '2px stroke geometry with optical sizing aligned to the typographic em box.',
            code: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#4fd8ff" stroke-width="2">\n  <circle cx="12" cy="12" r="10"/>\n</svg>`,
            render: () => `
              <div style="display:flex; gap:1rem; color:var(--cyan-electric);">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="m4.93 4.93 4.24 4.24"/></svg>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/></svg>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
              </div>`
          }
        ]
      }
    ];

    // Safe Component Code Dictionary Lookup (Zero inline code serialization)
    const COMPONENT_DATA_MAP = {};
    FACES_DATA.forEach(face => {
      face.components.forEach(comp => {
        COMPONENT_DATA_MAP[comp.id] = {
          name: comp.name,
          code: comp.code
        };
      });
    });

    function copyHexCode(hex) {
      if (navigator.clipboard) {
        navigator.clipboard.writeText(hex).then(() => {
          fireLiveToast(`Token ${hex} copied to clipboard!`);
        });
      }
    }

    function copyComponentCode(compName, code) {
      if (navigator.clipboard) {
        navigator.clipboard.writeText(code).then(() => {
          fireLiveToast(`Code for "${compName}" copied!`);
          triggerSoundAndHaptic();
        });
      }
    }

    /* ==========================================================================
       B. WEB AUDIO SYNTHESIZER
       ========================================================================== */
    class SciFiAudioEngine {
      constructor() {
        this.ctx = null;
        this.enabled = true;
      }

      init() {
        if (!this.ctx) {
          const AudioContext = window.AudioContext || window.webkitAudioContext;
          if (AudioContext) {
            this.ctx = new AudioContext();
          }
        }
        if (this.ctx && this.ctx.state === 'suspended') {
          this.ctx.resume();
        }
      }

      playTone(freq, duration = 0.3, type = 'sine', gainVal = 0.08) {
        if (!this.enabled) return;
        this.init();
        if (!this.ctx) return;

        const now = this.ctx.currentTime;
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();

        osc.type = type;
        osc.frequency.setValueAtTime(freq, now);

        gain.gain.setValueAtTime(gainVal, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + duration);

        osc.connect(gain);
        gain.connect(this.ctx.destination);

        osc.start(now);
        osc.stop(now + duration + 0.05);
      }

      playLaserShoot() {
        if (!this.enabled) return;
        this.init();
        if (!this.ctx) return;
        const now = this.ctx.currentTime;
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();

        osc.type = 'sawtooth';
        osc.frequency.setValueAtTime(80, now);
        osc.frequency.exponentialRampToValueAtTime(1200, now + 1.1);

        gain.gain.setValueAtTime(0.01, now);
        gain.gain.linearRampToValueAtTime(0.2, now + 0.9);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 1.2);

        osc.connect(gain);
        gain.connect(this.ctx.destination);
        osc.start(now);
        osc.stop(now + 1.25);
      }

      playLaserBurst() {
        if (!this.enabled) return;
        this.init();
        if (!this.ctx) return;
        const now = this.ctx.currentTime;

        const osc1 = this.ctx.createOscillator();
        const gain1 = this.ctx.createGain();
        osc1.type = 'triangle';
        osc1.frequency.setValueAtTime(180, now);
        osc1.frequency.exponentialRampToValueAtTime(32, now + 0.7);
        gain1.gain.setValueAtTime(0.35, now);
        gain1.gain.exponentialRampToValueAtTime(0.001, now + 0.8);
        osc1.connect(gain1);
        gain1.connect(this.ctx.destination);
        osc1.start(now);
        osc1.stop(now + 0.8);

        this.playTone(1800, 0.4, 'sine', 0.12);
      }

      playSnapHolo() {
        if (!this.enabled) return;
        this.playTone(520, 0.15, 'sine', 0.07);
        setTimeout(() => this.playTone(780, 0.2, 'sine', 0.09), 60);
      }
    }

    const audio = new SciFiAudioEngine();

    function triggerSoundAndHaptic() {
      audio.playTone(660, 0.12, 'sine', 0.06);
    }

    const soundBtn = document.getElementById('sound-btn');
    const soundStatusText = document.getElementById('sound-status-text');
    soundBtn.addEventListener('click', () => {
      audio.enabled = !audio.enabled;
      if (audio.enabled) {
        audio.init();
        soundStatusText.textContent = 'Audio: On';
        soundBtn.style.color = 'var(--cyan-electric)';
        audio.playSnapHolo();
      } else {
        soundStatusText.textContent = 'Audio: Off';
        soundBtn.style.color = 'var(--text-secondary)';
      }
    });

    function fireLiveToast(msg) {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      toast.className = 'toast-pill';
      toast.innerHTML = `
        <div style="width:8px; height:8px; border-radius:50%; background:var(--cyan-electric); box-shadow:0 0 10px var(--cyan-electric);"></div>
        <span>${msg}</span>
      `;
      container.appendChild(toast);
      audio.playTone(880, 0.25, 'sine', 0.09);
      setTimeout(() => {
        toast.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
        toast.style.opacity = '0';
        toast.style.transform = 'translateY(-10px)';
        setTimeout(() => toast.remove(), 400);
      }, 3500);
    }

    /* ==========================================================================
       C. NEBULA BACKGROUND, TWINKLING STARS & SHOOTING STARS
       ========================================================================== */
    const nebulaSceneWrap = document.getElementById('nebula-scene-wrap');
    const twinkleCanvas = document.getElementById('twinkle-stars-canvas');
    const twinkleCtx = twinkleCanvas.getContext('2d');
    const shootingCanvas = document.getElementById('shooting-star-canvas');
    const shootingCtx = shootingCanvas.getContext('2d');

    const testImg = new Image();
    testImg.src = 'nebula.jpg';
    testImg.onerror = () => {
      document.body.classList.add('nebula-fallback');
    };

    let stars = [];
    let shootingStar = null;
    let nextShootingStarTime = performance.now() + 15000;

    function resizeBackgroundCanvases() {
      const w = window.innerWidth;
      const h = window.innerHeight;
      twinkleCanvas.width = shootingCanvas.width = w;
      twinkleCanvas.height = shootingCanvas.height = h;

      const count = (w < 768) ? 80 : 180;
      stars = [];
      for (let i = 0; i < count; i++) {
        stars.push({
          x: Math.random() * w,
          y: Math.random() * h,
          radius: Math.random() * 1.4 + 0.3,
          baseAlpha: Math.random() * 0.7 + 0.2,
          phase: Math.random() * Math.PI * 2,
          speed: Math.random() * 0.03 + 0.015,
          color: (Math.random() > 0.3) ? '#ffffff' : (Math.random() > 0.5 ? '#4fd8ff' : '#ff5aa5')
        });
      }
    }

    window.addEventListener('resize', resizeBackgroundCanvases);
    resizeBackgroundCanvases();

    let parallaxTarget = { x: 0, y: 0 };
    let parallaxCurrent = { x: 0, y: 0 };

    window.addEventListener('mousemove', (e) => {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const xRatio = (e.clientX / window.innerWidth) - 0.5;
      const yRatio = (e.clientY / window.innerHeight) - 0.5;
      parallaxTarget.x = xRatio * 20;
      parallaxTarget.y = yRatio * 20;
    });

    let animPaused = false;
    document.addEventListener('visibilitychange', () => {
      animPaused = document.hidden;
    });

    function spawnShootingStar() {
      const w = shootingCanvas.width;
      const h = shootingCanvas.height;
      const startX = Math.random() * w * 0.8 + w * 0.1;
      const startY = Math.random() * h * 0.3;
      const length = Math.random() * 160 + 100;
      const angle = (Math.PI / 4) + (Math.random() - 0.5) * 0.2;
      shootingStar = {
        x: startX,
        y: startY,
        vx: Math.cos(angle) * 14,
        vy: Math.sin(angle) * 14,
        length: length,
        life: 1.0
      };
      nextShootingStarTime = performance.now() + 15000 + Math.random() * 10000;
    }

    function renderBackgroundFX(now) {
      if (!animPaused && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        parallaxCurrent.x += (parallaxTarget.x - parallaxCurrent.x) * 0.05;
        parallaxCurrent.y += (parallaxTarget.y - parallaxCurrent.y) * 0.05;
        nebulaSceneWrap.style.transform = `translate3d(${parallaxCurrent.x}px, ${parallaxCurrent.y}px, 0)`;

        twinkleCtx.clearRect(0, 0, twinkleCanvas.width, twinkleCanvas.height);
        for (let star of stars) {
          star.phase += star.speed;
          const alpha = star.baseAlpha + Math.sin(star.phase) * 0.3;
          twinkleCtx.beginPath();
          twinkleCtx.arc(star.x, star.y, star.radius, 0, Math.PI * 2);
          twinkleCtx.fillStyle = star.color;
          twinkleCtx.globalAlpha = Math.max(0.1, Math.min(1, alpha));
          twinkleCtx.fill();
        }
        twinkleCtx.globalAlpha = 1.0;

        if (now > nextShootingStarTime && !shootingStar) {
          spawnShootingStar();
        }

        shootingCtx.clearRect(0, 0, shootingCanvas.width, shootingCanvas.height);
        if (shootingStar) {
          shootingStar.x += shootingStar.vx;
          shootingStar.y += shootingStar.vy;
          shootingStar.life -= 0.025;

          const tailX = shootingStar.x - (shootingStar.vx / 14) * shootingStar.length;
          const tailY = shootingStar.y - (shootingStar.vy / 14) * shootingStar.length;

          const grad = shootingCtx.createLinearGradient(shootingStar.x, shootingStar.y, tailX, tailY);
          grad.addColorStop(0, 'rgba(255, 255, 255, ' + shootingStar.life + ')');
          grad.addColorStop(0.3, 'rgba(79, 216, 255, ' + (shootingStar.life * 0.8) + ')');
          grad.addColorStop(1, 'rgba(79, 216, 255, 0)');

          shootingCtx.beginPath();
          shootingCtx.moveTo(shootingStar.x, shootingStar.y);
          shootingCtx.lineTo(tailX, tailY);
          shootingCtx.strokeStyle = grad;
          shootingCtx.lineWidth = 2.5;
          shootingCtx.stroke();

          if (shootingStar.life <= 0) {
            shootingStar = null;
          }
        }
      }
      requestAnimationFrame(renderBackgroundFX);
    }
    requestAnimationFrame(renderBackgroundFX);

    /* ==========================================================================
       D. THREE.JS 3D ENERGY CUBE SCENE
       ========================================================================== */
    let scene, camera, renderer, cubeGroup, innerEnergyMesh, outerGlassMesh, spaceHaloMesh, particles;
    let targetRotation = { x: 0.35, y: -0.6 };
    let currentRotation = { x: 0.35, y: -0.6 };
    let rotationVelocity = { x: 0, y: 0 };
    let isDragging = false;
    let previousPointer = { x: 0, y: 0 };
    let activeFaceIndex = null;
    let isTransitioningToFace = false;
    let hoveredFaceIndex = null;
    let faceCanvasTextures = [];

    const CUBE_SIZE = 2.4;

    function renderFaceTexture(title, iconText, isHovered = false) {
      const c = document.createElement('canvas');
      c.width = 512;
      c.height = 512;
      const g = c.getContext('2d');

      const radGrad = g.createRadialGradient(256, 256, 40, 256, 256, 260);
      radGrad.addColorStop(0, isHovered ? 'rgba(79, 216, 255, 0.35)' : 'rgba(79, 216, 255, 0.18)');
      radGrad.addColorStop(0.7, 'rgba(10, 60, 255, 0.15)');
      radGrad.addColorStop(1, 'rgba(5, 6, 18, 0.45)');
      g.fillStyle = radGrad;
      g.fillRect(0, 0, 512, 512);

      g.strokeStyle = isHovered ? 'rgba(79, 216, 255, 0.2)' : 'rgba(79, 216, 255, 0.08)';
      g.lineWidth = 1;
      for (let i = 40; i < 512; i += 40) {
        g.beginPath();
        g.moveTo(i, 0); g.lineTo(i, 512);
        g.moveTo(0, i); g.lineTo(512, i);
        g.stroke();
      }

      g.strokeStyle = isHovered ? '#ffffff' : '#4fd8ff';
      g.lineWidth = isHovered ? 10 : 6;
      g.shadowColor = isHovered ? '#ff5aa5' : '#4fd8ff';
      g.shadowBlur = isHovered ? 26 : 14;
      g.strokeRect(16, 16, 480, 480);

      g.fillStyle = isHovered ? '#ffffff' : '#ff5aa5';
      const corners = [[20, 20], [484, 20], [20, 484], [484, 484]];
      corners.forEach(([cx, cy]) => {
        g.beginPath();
        g.arc(cx, cy, isHovered ? 8 : 6, 0, Math.PI * 2);
        g.fill();
      });

      g.font = 'bold 36px Unbounded, sans-serif';
      g.fillStyle = '#ffffff';
      g.textAlign = 'center';
      g.shadowColor = isHovered ? '#ff5aa5' : '#4fd8ff';
      g.shadowBlur = isHovered ? 24 : 16;
      g.fillText(title.toUpperCase(), 256, 270);

      g.font = '18px Manrope, sans-serif';
      g.fillStyle = isHovered ? '#4fd8ff' : '#8b99bd';
      g.shadowBlur = 0;
      g.fillText(isHovered ? 'EXPLORE ARCHITECTURE' : 'CLICK TO INSPECT', 256, 315);

      return c;
    }

    function initThreeScene() {
      const container = document.getElementById('canvas-container');
      const canvas = document.getElementById('webgl-cube-canvas');

      scene = new THREE.Scene();
      camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 100);
      camera.position.set(0, 0, 7.8);

      renderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: true, alpha: true });
      renderer.setSize(window.innerWidth, window.innerHeight);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

      cubeGroup = new THREE.Group();
      scene.add(cubeGroup);

      const innerGeo = new THREE.BoxGeometry(CUBE_SIZE * 0.72, CUBE_SIZE * 0.72, CUBE_SIZE * 0.72);
      const innerMat = new THREE.MeshBasicMaterial({
        color: 0x4fd8ff,
        transparent: true,
        opacity: 0.75,
        blending: THREE.AdditiveBlending
      });
      innerEnergyMesh = new THREE.Mesh(innerGeo, innerMat);
      cubeGroup.add(innerEnergyMesh);

      const innerWireGeo = new THREE.IcosahedronGeometry(CUBE_SIZE * 0.5, 1);
      const innerWireMat = new THREE.MeshBasicMaterial({
        color: 0xff5aa5,
        wireframe: true,
        transparent: true,
        opacity: 0.6,
        blending: THREE.AdditiveBlending
      });
      const wireCore = new THREE.Mesh(innerWireGeo, innerWireMat);
      innerEnergyMesh.add(wireCore);

      const faceTitles = ['Navigation', 'Inputs', 'Feedback', 'Data', 'Future Interfaces', 'Foundations'];
      const materials = [];
      faceCanvasTextures = [];

      for (let i = 0; i < 6; i++) {
        const tex = new THREE.CanvasTexture(renderFaceTexture(faceTitles[i], '0' + (i + 1)));
        faceCanvasTextures.push(tex);
        materials.push(new THREE.MeshBasicMaterial({ map: tex, transparent: true, opacity: 0.88 }));
      }

      const outerGeo = new THREE.BoxGeometry(CUBE_SIZE, CUBE_SIZE, CUBE_SIZE);
      outerGlassMesh = new THREE.Mesh(outerGeo, materials);
      cubeGroup.add(outerGlassMesh);

      const edgesGeo = new THREE.EdgesGeometry(outerGeo);
      const edgesMat = new THREE.LineBasicMaterial({ color: 0x4fd8ff, linewidth: 2 });
      const edgesLine = new THREE.LineSegments(edgesGeo, edgesMat);
      cubeGroup.add(edgesLine);

      const haloGeo = new THREE.PlaneGeometry(6.5, 6.5);
      const haloCanvas = document.createElement('canvas');
      haloCanvas.width = 256; haloCanvas.height = 256;
      const hCtx = haloCanvas.getContext('2d');
      const hGrad = hCtx.createRadialGradient(128, 128, 20, 128, 128, 120);
      hGrad.addColorStop(0, 'rgba(79, 216, 255, 0.45)');
      hGrad.addColorStop(0.5, 'rgba(10, 60, 255, 0.18)');
      hGrad.addColorStop(1, 'rgba(5, 6, 18, 0)');
      hCtx.fillStyle = hGrad;
      hCtx.fillRect(0, 0, 256, 256);

      const haloTexture = new THREE.CanvasTexture(haloCanvas);
      const haloMat = new THREE.MeshBasicMaterial({
        map: haloTexture,
        transparent: true,
        opacity: 0.7,
        depthWrite: false,
        blending: THREE.AdditiveBlending
      });
      spaceHaloMesh = new THREE.Mesh(haloGeo, haloMat);
      spaceHaloMesh.position.z = -0.5;
      scene.add(spaceHaloMesh);

      const partCount = (window.innerWidth < 768) ? 50 : 140;
      const partGeo = new THREE.BufferGeometry();
      const posArray = new Float32Array(partCount * 3);
      for (let i = 0; i < partCount * 3; i += 3) {
        const u = Math.random();
        const v = Math.random();
        const theta = u * 2.0 * Math.PI;
        const phi = Math.acos(2.0 * v - 1.0);
        const r = Math.cbrt(Math.random()) * 4.5 + 1.2;
        posArray[i] = r * Math.sin(phi) * Math.cos(theta);
        posArray[i + 1] = r * Math.sin(phi) * Math.sin(theta);
        posArray[i + 2] = r * Math.cos(phi);
      }
      partGeo.setAttribute('position', new THREE.BufferAttribute(posArray, 3));

      const pCanvas = document.createElement('canvas');
      pCanvas.width = 64; pCanvas.height = 64;
      const pCtx = pCanvas.getContext('2d');
      const pGrad = pCtx.createRadialGradient(32, 32, 2, 32, 32, 30);
      pGrad.addColorStop(0, '#ffffff');
      pGrad.addColorStop(0.4, '#4fd8ff');
      pGrad.addColorStop(1, 'rgba(79, 216, 255, 0)');
      pCtx.fillStyle = pGrad;
      pCtx.fillRect(0, 0, 64, 64);

      const pTexture = new THREE.CanvasTexture(pCanvas);
      const partMat = new THREE.PointsMaterial({
        size: 0.14,
        map: pTexture,
        transparent: true,
        opacity: 0.7,
        blending: THREE.AdditiveBlending,
        depthWrite: false
      });
      particles = new THREE.Points(partGeo, partMat);
      scene.add(particles);

      setupInteractions();
      window.addEventListener('resize', onWindowResize);
    }

    function onWindowResize() {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
    }

    const raycaster = new THREE.Raycaster();
    const mouseNorm = new THREE.Vector2();
    const tooltip = document.getElementById('face-hover-tooltip');
    const heroHint = document.getElementById('hero-cube-hint');

    function dismissHeroHint() {
      if (heroHint && !heroHint.classList.contains('faded')) {
        heroHint.classList.add('faded');
      }
    }

    function getIntersectedFaceIndex(event) {
      const rect = renderer.domElement.getBoundingClientRect();
      mouseNorm.x = ((event.clientX - rect.left) / rect.width) * 2 - 1;
      mouseNorm.y = -((event.clientY - rect.top) / rect.height) * 2 + 1;

      raycaster.setFromCamera(mouseNorm, camera);
      const intersects = raycaster.intersectObject(outerGlassMesh);
      if (intersects.length > 0) {
        return intersects[0].face.materialIndex;
      }
      return null;
    }

    function updateFaceHoverState(faceIdx) {
      if (hoveredFaceIndex === faceIdx) return;
      
      if (hoveredFaceIndex !== null && FACES_DATA[hoveredFaceIndex]) {
        const prevTitle = FACES_DATA[hoveredFaceIndex].name;
        faceCanvasTextures[hoveredFaceIndex].image = renderFaceTexture(prevTitle, '0' + (hoveredFaceIndex + 1), false);
        faceCanvasTextures[hoveredFaceIndex].needsUpdate = true;
      }

      hoveredFaceIndex = faceIdx;

      if (hoveredFaceIndex !== null && FACES_DATA[hoveredFaceIndex]) {
        const newTitle = FACES_DATA[hoveredFaceIndex].name;
        faceCanvasTextures[hoveredFaceIndex].image = renderFaceTexture(newTitle, '0' + (hoveredFaceIndex + 1), true);
        faceCanvasTextures[hoveredFaceIndex].needsUpdate = true;
      }
    }

    function setupInteractions() {
      const dom = renderer.domElement;

      dom.addEventListener('pointerdown', (e) => {
        dismissHeroHint();
        isDragging = true;
        isTransitioningToFace = false;
        previousPointer.x = e.clientX;
        previousPointer.y = e.clientY;
        rotationVelocity.x = 0;
        rotationVelocity.y = 0;
      });

      window.addEventListener('pointermove', (e) => {
        if (isDragging) {
          const deltaX = e.clientX - previousPointer.x;
          const deltaY = e.clientY - previousPointer.y;

          rotationVelocity.y = deltaX * 0.005;
          rotationVelocity.x = deltaY * 0.005;

          targetRotation.y += rotationVelocity.y;
          targetRotation.x += rotationVelocity.x;

          previousPointer.x = e.clientX;
          previousPointer.y = e.clientY;
          tooltip.classList.remove('visible');
          updateFaceHoverState(null);
        } else {
          const faceIdx = getIntersectedFaceIndex(e);
          if (faceIdx !== null && FACES_DATA[faceIdx]) {
            updateFaceHoverState(faceIdx);
            tooltip.textContent = `${FACES_DATA[faceIdx].name} • Click to Inspect`;
            tooltip.style.left = e.clientX + 'px';
            tooltip.style.top = e.clientY + 'px';
            tooltip.classList.add('visible');
          } else {
            updateFaceHoverState(null);
            tooltip.classList.remove('visible');
          }
        }
      });

      window.addEventListener('pointerup', (e) => {
        if (isDragging) {
          isDragging = false;
          const moveDist = Math.hypot(e.clientX - previousPointer.x, e.clientY - previousPointer.y);
          if (moveDist < 5) {
            const faceIdx = getIntersectedFaceIndex(e);
            if (faceIdx !== null) {
              snapToFaceAndOpen(faceIdx);
            }
          }
        }
      });

      window.addEventListener('keydown', (e) => {
        if (document.activeElement.tagName === 'INPUT' || document.activeElement.tagName === 'TEXTAREA') return;
        dismissHeroHint();

        if (e.key === 'ArrowRight') {
          if (activeFaceIndex !== null) {
            snapToFaceAndOpen((activeFaceIndex + 1) % 6);
          } else {
            targetRotation.y += 0.3;
          }
          e.preventDefault();
        }
        if (e.key === 'ArrowLeft') {
          if (activeFaceIndex !== null) {
            snapToFaceAndOpen((activeFaceIndex + 5) % 6);
          } else {
            targetRotation.y -= 0.3;
          }
          e.preventDefault();
        }
        if (e.key === 'ArrowUp') { targetRotation.x -= 0.3; e.preventDefault(); }
        if (e.key === 'ArrowDown') { targetRotation.x += 0.3; e.preventDefault(); }
        if (e.key === 'Escape') { closeInspector(); }
      });
    }

    function snapToFaceAndOpen(faceIndex) {
      dismissHeroHint();
      if (faceIndex < 0 || faceIndex >= FACES_DATA.length) return;
      const face = FACES_DATA[faceIndex];

      activeFaceIndex = faceIndex;
      isTransitioningToFace = true;
      targetRotation.x = face.euler.x;
      targetRotation.y = face.euler.y;

      document.querySelectorAll('.dock-btn').forEach(btn => {
        btn.classList.toggle('active', parseInt(btn.dataset.faceIndex) === faceIndex);
      });

      audio.playSnapHolo();
      openInspector(face);
    }

    let clock = new THREE.Clock();

    function animateThreeScene() {
      requestAnimationFrame(animateThreeScene);
      if (animPaused) return;

      const delta = clock.getDelta();
      const time = clock.getElapsedTime();

      if (!isDragging && !isTransitioningToFace) {
        targetRotation.x += rotationVelocity.x;
        targetRotation.y += rotationVelocity.y;
        rotationVelocity.x *= 0.94;
        rotationVelocity.y *= 0.94;

        if (Math.abs(rotationVelocity.x) < 0.0001 && Math.abs(rotationVelocity.y) < 0.0001) {
          targetRotation.y += 0.002;
        }
      }

      currentRotation.x += (targetRotation.x - currentRotation.x) * (isTransitioningToFace ? 0.12 : 0.08);
      currentRotation.y += (targetRotation.y - currentRotation.y) * (isTransitioningToFace ? 0.12 : 0.08);

      cubeGroup.rotation.x = currentRotation.x;
      cubeGroup.rotation.y = currentRotation.y;

      const bobY = Math.sin(time * 1.6) * 0.16;
      cubeGroup.position.y = bobY;

      if (spaceHaloMesh) {
        const pulse = 1 + Math.sin(time * 2.2) * 0.06;
        spaceHaloMesh.scale.set(pulse, pulse, 1);
        spaceHaloMesh.position.y = bobY * 0.6;
      }

      if (innerEnergyMesh) {
        const pulse = 1 + Math.sin(time * 3) * 0.08;
        innerEnergyMesh.scale.set(pulse, pulse, pulse);
        innerEnergyMesh.rotation.y = -time * 0.5;
        innerEnergyMesh.rotation.x = time * 0.3;
      }

      if (particles) {
        particles.rotation.y = time * 0.04;
        particles.rotation.x = time * 0.02;
      }

      const targetCamZ = (activeFaceIndex !== null) ? 5.8 : 7.8;
      const targetCamX = (activeFaceIndex !== null && window.innerWidth > 900) ? -1.4 : 0;
      camera.position.z += (targetCamZ - camera.position.z) * 0.08;
      camera.position.x += (targetCamX - camera.position.x) * 0.08;

      renderer.render(scene, camera);
    }

    /* ==========================================================================
       E. COMPONENT INSPECTOR SHEET & EVENT DELEGATION (CSP COMPLIANT)
       ========================================================================== */
    const inspector = document.getElementById('face-inspector');
    const inspectorEyebrow = document.getElementById('inspector-eyebrow');
    const inspectorCounter = document.getElementById('inspector-counter');
    const inspectorTitle = document.getElementById('inspector-title');
    const inspectorDesc = document.getElementById('inspector-desc');
    const cardsGrid = document.getElementById('component-cards-grid');
    const backToCubeBtn = document.getElementById('back-to-cube-btn');
    const prevFaceBtn = document.getElementById('prev-face-btn');
    const nextFaceBtn = document.getElementById('next-face-btn');

    function openInspector(face) {
      document.body.classList.add('face-open');
      inspectorEyebrow.textContent = face.eyebrow;
      inspectorCounter.textContent = `${face.index + 1} / 6`;
      inspectorTitle.textContent = face.name;
      inspectorDesc.textContent = face.desc;

      cardsGrid.innerHTML = '';
      face.components.forEach(comp => {
        const card = document.createElement('article');
        card.className = 'component-card';
        card.id = `comp-${comp.id}`;
        card.innerHTML = `
          <div class="card-header-info">
            <div class="card-top-row">
              <h3 class="comp-name">${comp.name}</h3>
              <button class="copy-code-btn" data-action="copy-code" data-comp-id="${comp.id}" title="Copy Component HTML/CSS snippet">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                </svg>
                <span>Copy code</span>
              </button>
            </div>
            <p class="comp-rule">${comp.rule}</p>
          </div>
          <div class="comp-interactive-preview">
            ${comp.render()}
          </div>
        `;
        cardsGrid.appendChild(card);
      });

      inspector.classList.add('open');
      audio.playTone(720, 0.2, 'sine', 0.08);
    }

    function closeInspector() {
      document.body.classList.remove('face-open');
      inspector.classList.remove('open');
      activeFaceIndex = null;
      isTransitioningToFace = false;
      document.querySelectorAll('.dock-btn').forEach(btn => btn.classList.remove('active'));
      audio.playTone(440, 0.2, 'sine', 0.06);
    }

    backToCubeBtn.addEventListener('click', closeInspector);
    document.getElementById('brand-home-btn').addEventListener('click', (e) => {
      e.preventDefault();
      closeInspector();
      targetRotation = { x: 0.35, y: -0.6 };
    });

    prevFaceBtn.addEventListener('click', () => {
      if (activeFaceIndex !== null) {
        snapToFaceAndOpen((activeFaceIndex + 5) % 6);
      }
    });

    nextFaceBtn.addEventListener('click', () => {
      if (activeFaceIndex !== null) {
        snapToFaceAndOpen((activeFaceIndex + 1) % 6);
      }
    });

    inspector.addEventListener('click', (e) => {
      if (e.target === inspector) closeInspector();
    });

    document.querySelectorAll('.dock-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const idx = parseInt(btn.dataset.faceIndex);
        snapToFaceAndOpen(idx);
      });
    });

    // Central Event Delegation on Cards Grid (Replaces all inline handlers)
    cardsGrid.addEventListener('click', (e) => {
      const copyBtn = e.target.closest('[data-action="copy-code"]');
      if (copyBtn) {
        const compId = copyBtn.dataset.compId;
        const item = COMPONENT_DATA_MAP[compId];
        if (item) {
          copyComponentCode(item.name, item.code);
        }
        return;
      }

      const tabBtn = e.target.closest('[data-action="switch-tab"]');
      if (tabBtn) {
        const wrap = tabBtn.closest('.demo-segmented-tabs');
        if (wrap) {
          wrap.querySelectorAll('.demo-tab-item').forEach(b => b.classList.remove('active'));
          tabBtn.classList.add('active');
          triggerSoundAndHaptic();
        }
        return;
      }

      const hexBtn = e.target.closest('[data-action="copy-hex"]');
      if (hexBtn) {
        copyHexCode(hexBtn.dataset.hex);
        return;
      }

      const toastBtn = e.target.closest('[data-action="emit-toast"]');
      if (toastBtn) {
        fireLiveToast('Synaptic Core Synchronized (0.02ms latency)');
        return;
      }

      const toggleBtn = e.target.closest('[data-action="toggle-quantum"]');
      if (toggleBtn) {
        toggleBtn.classList.toggle('active');
        triggerSoundAndHaptic();
        return;
      }

      const soundBtn = e.target.closest('[data-action="sound-haptic"]');
      if (soundBtn) {
        triggerSoundAndHaptic();
        return;
      }
    });

    cardsGrid.addEventListener('input', (e) => {
      const slider = e.target.closest('[data-action="flux-slider"]');
      if (slider) {
        const valDisplay = slider.closest('.flux-slider-wrap')?.querySelector('.flux-slider-val');
        if (valDisplay) {
          valDisplay.textContent = slider.value + ' GHz';
        }
      }
    });

    cardsGrid.addEventListener('change', (e) => {
      const select = e.target.closest('[data-action="orbital-select"]');
      if (select) {
        triggerSoundAndHaptic();
      }
    });

    /* ==========================================================================
       F. GLOWING LIVE SEARCH ENGINE
       ========================================================================== */
    const searchInput = document.getElementById('global-search-input');
    const searchDropdown = document.getElementById('search-dropdown');

    const SEARCH_CATALOG = [];
    FACES_DATA.forEach(face => {
      SEARCH_CATALOG.push({
        type: 'face',
        name: face.name,
        desc: face.desc,
        faceIndex: face.index,
        faceName: face.name,
        targetId: null
      });
      face.components.forEach(comp => {
        SEARCH_CATALOG.push({
          type: 'component',
          name: comp.name,
          desc: comp.rule,
          faceIndex: face.index,
          faceName: face.name,
          targetId: comp.id
        });
      });
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === '/' && document.activeElement !== searchInput) {
        e.preventDefault();
        searchInput.focus();
        searchInput.select();
        dismissHeroHint();
      }
    });

    searchInput.addEventListener('input', () => {
      dismissHeroHint();
      const query = searchInput.value.trim().toLowerCase();
      if (!query) {
        searchDropdown.classList.remove('open');
        return;
      }

      const results = SEARCH_CATALOG.filter(item => 
        item.name.toLowerCase().includes(query) || 
        item.desc.toLowerCase().includes(query) ||
        item.faceName.toLowerCase().includes(query)
      );

      if (results.length > 0) {
        const topMatch = results[0];
        targetRotation.x = FACES_DATA[topMatch.faceIndex].euler.x;
        targetRotation.y = FACES_DATA[topMatch.faceIndex].euler.y;
        isTransitioningToFace = true;
      }

      renderSearchResults(results, query);
    });

    function renderSearchResults(results, query) {
      searchDropdown.innerHTML = '';
      if (results.length === 0) {
        searchDropdown.innerHTML = `
          <div class="search-empty-state">
            <div class="search-empty-title">No direct match for "${query}"</div>
            <div class="search-empty-sub">Explore these foundational paradigms:</div>
            <div class="search-suggest-chips">
              <span class="suggest-chip" data-action="search-tag" data-tag="toggle">toggle</span>
              <span class="suggest-chip" data-action="search-tag" data-tag="voice">voice</span>
              <span class="suggest-chip" data-action="search-tag" data-tag="chart">chart</span>
              <span class="suggest-chip" data-action="search-tag" data-tag="navbar">navbar</span>
              <span class="suggest-chip" data-action="search-tag" data-tag="color">color</span>
              <span class="suggest-chip" data-action="search-tag" data-tag="toasts">toasts</span>
            </div>
          </div>
        `;
      } else {
        results.slice(0, 6).forEach(item => {
          const row = document.createElement('div');
          row.className = 'search-item';
          row.innerHTML = `
            <div class="search-item-info">
              <span class="search-item-name">${item.name}</span>
              <span class="search-item-desc">${item.desc.substring(0, 55)}...</span>
            </div>
            <span class="search-item-face-pill">${item.faceName}</span>
          `;
          row.addEventListener('click', () => {
            selectSearchResult(item);
          });
          searchDropdown.appendChild(row);
        });
      }
      searchDropdown.classList.add('open');
    }

    // Search Dropdown Delegation (CSP Safe)
    searchDropdown.addEventListener('click', (e) => {
      const chip = e.target.closest('[data-action="search-tag"]');
      if (chip) {
        searchInput.value = chip.dataset.tag;
        searchInput.dispatchEvent(new Event('input'));
      }
    });

    function selectSearchResult(item) {
      searchDropdown.classList.remove('open');
      searchInput.value = '';
      snapToFaceAndOpen(item.faceIndex);

      if (item.targetId) {
        setTimeout(() => {
          const el = document.getElementById(`comp-${item.targetId}`);
          if (el) {
            el.scrollIntoView({ behavior: 'smooth', block: 'center' });
            el.classList.add('search-target');
            setTimeout(() => el.classList.remove('search-target'), 3500);
          }
        }, 300);
      }
    }

    document.addEventListener('click', (e) => {
      if (!searchInput.contains(e.target) && !searchDropdown.contains(e.target)) {
        searchDropdown.classList.remove('open');
      }
    });

    /* ==========================================================================
       G. OPENING LASER INTRO (SHOWN ONCE PER SESSION)
       ========================================================================== */
    const introOverlay = document.getElementById('intro-overlay');
    const laserBeam = document.getElementById('laser-beam');
    const laserFlare = document.getElementById('laser-flare');
    const laserFlash = document.getElementById('laser-flash');
    const brandLetters = document.querySelectorAll('.brand-letter');
    const brandTagline = document.getElementById('brand-tagline');
    const skipBtn = document.getElementById('skip-intro');
    const skipBar = document.getElementById('skip-bar');
    const replayIntroBtn = document.getElementById('replay-intro-btn');

    let introTimers = [];
    let progressTimer = null;

    function clearIntroTimers() {
      introTimers.forEach(t => clearTimeout(t));
      introTimers = [];
      if (progressTimer) clearInterval(progressTimer);
    }

    function finishIntro() {
      clearIntroTimers();
      sessionStorage.setItem('nikneuron_intro_seen', 'true');
      introOverlay.classList.add('fade-out');
      setTimeout(() => {
        introOverlay.style.display = 'none';
      }, 1200);
    }

    function runOpeningIntro(force = false) {
      if (!force && sessionStorage.getItem('nikneuron_intro_seen') === 'true') {
        introOverlay.style.display = 'none';
        return;
      }

      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        introOverlay.style.display = 'none';
        return;
      }

      clearIntroTimers();
      introOverlay.style.display = 'flex';
      introOverlay.classList.remove('fade-out', 'split', 'ignite');

      laserBeam.style.transition = 'none';
      laserBeam.style.height = '0%';
      laserBeam.style.opacity = '1';
      laserFlare.style.opacity = '0';
      laserFlare.style.top = '0%';
      laserFlash.style.opacity = '0';

      brandLetters.forEach(l => l.classList.remove('active'));
      brandTagline.classList.remove('active');

      const duration = 6200;
      const startTime = performance.now();
      const circumference = 37.7;
      skipBar.style.strokeDashoffset = '0';

      progressTimer = setInterval(() => {
        const elapsed = performance.now() - startTime;
        const p = Math.min(elapsed / duration, 1);
        skipBar.style.strokeDashoffset = String(circumference * p);
        if (p >= 1) clearInterval(progressTimer);
      }, 50);

      introTimers.push(setTimeout(() => {
        audio.playLaserShoot();
        laserBeam.style.transition = 'height 1.1s cubic-bezier(0.2, 0.8, 0.2, 1)';
        laserBeam.style.height = '100%';
        laserFlare.style.opacity = '1';
        laserFlare.style.transition = 'top 1.1s cubic-bezier(0.2, 0.8, 0.2, 1)';
        laserFlare.style.top = '100%';
      }, 400));

      introTimers.push(setTimeout(() => {
        audio.playLaserBurst();
        laserFlash.style.opacity = '0.9';
        setTimeout(() => laserFlash.style.opacity = '0', 350);
      }, 1500));

      introTimers.push(setTimeout(() => {
        introOverlay.classList.add('split');
        laserBeam.style.opacity = '0';
        laserFlare.style.opacity = '0';
      }, 1900));

      introTimers.push(setTimeout(() => {
        introOverlay.classList.add('ignite');
      }, 2300));

      brandLetters.forEach((letter, i) => {
        introTimers.push(setTimeout(() => {
          letter.classList.add('active');
          audio.playTone(320 + i * 45, 0.25, 'sine', 0.05);
        }, 2800 + i * 130));
      });

      introTimers.push(setTimeout(() => {
        brandTagline.classList.add('active');
      }, 4300));

      introTimers.push(setTimeout(() => {
        finishIntro();
      }, 6200));
    }

    skipBtn.addEventListener('click', finishIntro);
    replayIntroBtn.addEventListener('click', () => runOpeningIntro(true));

    /* ==========================================================================
       H. INITIALIZATION
       ========================================================================== */
    window.addEventListener('DOMContentLoaded', () => {
      initThreeScene();
      animateThreeScene();
      runOpeningIntro(false);
    });
  </script>
</body>
</html>
